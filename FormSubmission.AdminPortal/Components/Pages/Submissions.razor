@page "/submissions"
@rendermode InteractiveServer
@using FormSubmission.AdminPortal.Models
@inject FormSubmission.AdminPortal.Services.SubmissionApiService Api
@inject FormSubmission.AdminPortal.Services.AuthStateService Auth
<div class="card"><h2>Submissions</h2>@if(!Auth.IsLoggedIn){<p class="error">Please login first.</p><a href="/login">Login</a>}else{<div class="form-row"><label>Status</label><select @bind="status"><option value="">All</option><option>Pending</option><option>InReview</option><option>Approved</option><option>Rejected</option></select></div><button @onclick="LoadAsync">Load</button>@if(error is not null){<p class="error">@error</p>}<table><thead><tr><th>Created</th><th>Name</th><th>Email</th><th>Message</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var item in submissions){<tr><td>@item.CreatedAtUtc.ToLocalTime()</td><td>@item.FullName</td><td>@item.Email</td><td>@item.Message</td><td>@item.Status</td><td><select @bind="selected[item.Id]"><option>Pending</option><option>InReview</option><option>Approved</option><option>Rejected</option></select><button @onclick="()=>UpdateAsync(item.Id)">Save</button></td></tr>}</tbody></table>}</div>@code{private List<SubmissionDto> submissions=new();private Dictionary<Guid,string> selected=new();private string? status;private string? error;private async Task LoadAsync(){try{submissions=await Api.GetAllAsync(status);selected=submissions.ToDictionary(x=>x.Id,x=>x.Status);}catch{error="Failed to load. Check API/token.";}}private async Task UpdateAsync(Guid id){if(selected.TryGetValue(id,out var s)){var ok=await Api.UpdateStatusAsync(id,s);if(!ok) error="Update failed"; await LoadAsync();}}}